{
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [":443", ":80"],
          "routes": [
            {
              "match": [{"host": ["influxdb.tucanorobotics.co"]}],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [{"dial": "localhost:8086"}]
                }
              ]
            },
            {
              "match": [{"host": ["autoponico-ws.tucanorobotics.co"]}],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [{"dial": "localhost:3000"}]
                }
              ]
            },
            {
              "match": [{"host": ["cameras.tucanorobotics.co"]}],
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "set": {
                      "Access-Control-Allow-Origin": ["*"],
                      "Access-Control-Allow-Methods": ["GET, POST, OPTIONS"],
                      "Access-Control-Allow-Headers": ["Content-Type"]
                    }
                  }
                },
                {
                  "handler": "reverse_proxy",
                  "upstreams": [{"dial": "100.66.228.7:8555"}],
                  "transport": {
                    "protocol": "http",
                    "read_timeout": 0,
                    "write_timeout": 0
                  }
                }
              ]
            }
          ]
        }
      }
    }
  }
}