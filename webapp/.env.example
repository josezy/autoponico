# Postgres for itineraries, phases, routines, logs, and clone batches.
# InfluxDB (INFLUXDB_DATA_*) stays sensor-only and is unchanged.
DATABASE_URL=postgres://autoponico:autoponico@127.0.0.1:5432/autoponico

# Photos. local writes webapp/data/photos (dev). s3 is the object-storage path.
PHOTO_STORAGE=local
# PHOTO_LOCAL_DIR=./data/photos

# PHOTO_STORAGE=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional public base. When empty, the app returns a one-hour signed GET URL.
# S3_PUBLIC_URL_BASE=
