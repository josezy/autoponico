# Copy to scripts/tasmota.env and fill in (*.env is gitignored).
#   cp scripts/tasmota.env.example scripts/tasmota.env

TASMOTA_WIFI_SSID=AGROTUCANO
TASMOTA_WIFI_PASSWORD=

# rata public IP (ws-server MQTT). Override if you use a LAN address.
TASMOTA_MQTT_HOST=
TASMOTA_MQTT_PORT=1883

# Per-device — must match TASMOTA_DEVICES in webapp/src/hooks/useMqtt.tsx
TASMOTA_TOPIC=main-pump
TASMOTA_FRIENDLY_NAME=Main Pump

# Colombia
TASMOTA_TIMEZONE=-5
TASMOTA_NTP=pool.ntp.org
